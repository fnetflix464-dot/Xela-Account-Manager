{
  "name": "xela-account-manager",
  "version": "2.0.0",
  "description": "Offline, encrypted local vault for accounts, notes, cards, keys and more",
  "homepage": "./",
  "private": true,
  "author": "fnetflix464-dot",
  "license": "MIT",
  "main": "public/electron.js",
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^8.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "playwright": "^1.62.0",
    "wait-on": "^7.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "electron public/electron.js",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "test:e2e": "npm run react-build && playwright test",
    "build": "npm run react-build && electron-builder",
    "dist": "npm run react-build && electron-builder --publish never"
  },
  "build": {
    "extends": null,
    "appId": "com.xela.accountmanager",
    "productName": "Xela Account Manager",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.cjs",
      "src/models/**/*",
      "src/services/**/*",
      "src/repositories/**/*",
      "src/commands/**/*",
      "src/data/**/*",
      "!src/**/*.test.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
