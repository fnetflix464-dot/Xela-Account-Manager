{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xela Account Manager",
  "version": "2.0.0",
  "identifier": "com.xela.accountmanager",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run react-build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xela Account Manager",
        "width": 520,
        "height": 700,
        "minWidth": 460,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
